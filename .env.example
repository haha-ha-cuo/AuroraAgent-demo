# 复制为 .env 并填入真实值。密钥不提交仓库。
# 任意 OpenAI 兼容端点均可（OpenAI / DeepSeek / 本地网关）。

# Provider：离线演示用 mock，真实请求用 openai
AGENT_PROVIDER=mock

# API 密钥（选择 openai 时必填）
AGENT_API_KEY=

# OpenAI 兼容端点
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
# Ollama:   http://localhost:11434/v1
AGENT_BASE_URL=https://api.openai.com/v1

# 模型名
AGENT_MODEL=gpt-4o-mini
